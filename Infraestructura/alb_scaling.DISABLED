############################
# VARIABLES EDITABLES (2)
############################
variable "unique_suffix" {
  description = "Sufijo único para el nombre del bucket de logs (global)."
  type        = string
  default     = "lordgambit-20251101"   # <-- CAMBIA a algo único si da conflicto
}

variable "bff_lambda_function_name" {
  description = "Nombre de la Lambda (BFF) que el ALB invocará"
  type        = string
  default     = "bff-lambda"            # <-- CAMBIA al nombre real de tu Lambda
}

############################
# DESCUBRIR VPC/SUBNETS (default en us-east-1)
############################
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default_subnets" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

############################
# SG del ALB (HTTP 80 abierto)
############################
resource "aws_security_group" "alb_sg" {
  name        = "alb-sg"
  description = "SG para ALB público"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
}

############################
# S3 para Access Logs del ALB
############################
resource "aws_s3_bucket" "alb_logs" {
  bucket        = "alb-logs-${var.unique_suffix}"
  force_destroy = true
}

data "aws_elb_service_account" "this" {}

resource "aws_s3_bucket_policy" "alb_logs_policy" {
  bucket = aws_s3_bucket.alb_logs.id
  policy = jsonencode({
    Version = "2012-10-17",
    Statement = [{
      Sid       = "AWSLogDeliveryWrite",
      Effect    = "Allow",
      Principal = { AWS = data.aws_elb_service_account.this.arn },
      Action    = "s3:PutObject",
      Resource  = "${aws_s3_bucket.alb_logs.arn}/*"
    }]
  })
}

############################
# ALB + Listener 80
############################
resource "aws_lb" "bff_alb" {
  name               = "bff-alb"
  load_balancer_type = "application"
  subnets            = data.aws_subnets.default_subnets.ids
  security_groups    = [aws_security_group.alb_sg.id]

  access_logs {
    bucket  = aws_s3_bucket.alb_logs.bucket
    prefix  = "alb"
    enabled = true
  }
}

resource "aws_lb_listener" "http_80" {
  load_balancer_arn = aws_lb.bff_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type = "fixed-response"
    fixed_response {
      content_type = "text/plain"
      message_body = "No default route"
      status_code  = "404"
    }
  }
}

############################
# Target Group (Lambda) + permisos
############################
data "aws_lambda_function" "bff" {
  function_name = var.bff_lambda_function_name
}

resource "aws_lb_target_group" "bff_lambda_tg" {
  name        = "bff-lambda-tg"
  target_type = "lambda"
}

resource "aws_lambda_permission" "allow_alb_invoke" {
  statement_id  = "AllowExecutionFromALB"
  action        = "lambda:InvokeFunction"
  function_name = data.aws_lambda_function.bff.function_name
  principal     = "elasticloadbalancing.amazonaws.com"
  source_arn    = aws_lb_target_group.bff_lambda_tg.arn
}

resource "aws_lb_target_group_attachment" "attach" {
  target_group_arn = aws_lb_target_group.bff_lambda_tg.arn
  target_id        = data.aws_lambda_function.bff.arn
}

resource "aws_lb_listener_rule" "fwd_all" {
  listener_arn = aws_lb_listener.http_80.arn
  priority     = 100
  action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.bff_lambda_tg.arn
  }
  condition { path_pattern { values = ["/*"] } }
}

############################
# (Opcional recomendado) Concurrencia y Auto Scaling
############################
resource "aws_lambda_alias" "bff_live" {
  name             = "live"
  function_name    = data.aws_lambda_function.bff.function_name
  function_version = "$LATEST"
}

resource "aws_lambda_provisioned_concurrency_config" "bff_pc" {
  function_name                     = data.aws_lambda_function.bff.function_name
  qualifier                         = aws_lambda_alias.bff_live.name
  provisioned_concurrent_executions = 2
}

resource "aws_appautoscaling_target" "bff_pc_target" {
  max_capacity       = 10
  min_capacity       = 2
  resource_id        = "function:${data.aws_lambda_function.bff.function_name}:${aws_lambda_alias.bff_live.name}"
  scalable_dimension = "lambda:function:ProvisionedConcurrency"
  service_namespace  = "lambda"
}

resource "aws_appautoscaling_policy" "bff_latency_policy" {
  name               = "bff-lambda-latency"
  policy_type        = "TargetTrackingScaling"
  resource_id        = aws_appautoscaling_target.bff_pc_target.resource_id
  scalable_dimension = aws_appautoscaling_target.bff_pc_target.scalable_dimension
  service_namespace  = aws_appautoscaling_target.bff_pc_target.service_namespace

  target_tracking_scaling_policy_configuration {
    target_value = 2000
    customized_metric_specification {
      metric_name = "Duration"
      namespace   = "AWS/Lambda"
      statistic   = "p99"
      dimensions  = { FunctionName = data.aws_lambda_function.bff.function_name }
    }
    scale_in_cooldown  = 60
    scale_out_cooldown = 60
  }
}

############################
# Alarmas y dashboard mínimos
############################
data "aws_region" "current" {}

resource "aws_cloudwatch_metric_alarm" "tg_5xx" {
  alarm_name          = "bff-tg-5xx"
  comparison_operator = "GreaterThanThreshold"
  evaluation_periods  = 1
  threshold           = 10
  metric_name         = "HTTPCode_Target_5XX_Count"
  namespace           = "AWS/ApplicationELB"
  period              = 300
  statistic           = "Sum"
  treat_missing_data  = "notBreaching"
  dimensions = {
    TargetGroup  = aws_lb_target_group.bff_lambda_tg.arn_suffix
    LoadBalancer = aws_lb.bff_alb.arn_suffix
  }
}

resource "aws_cloudwatch_dashboard" "alb_dash" {
  dashboard_name = "bff-alb-dashboard"
  dashboard_body = jsonencode({
    widgets = [
      { "type": "metric", "width": 12, "height": 6,
        "properties": { "metrics": [[ "AWS/ApplicationELB","RequestCount","LoadBalancer", aws_lb.bff_alb.arn_suffix ]],
                        "region": data.aws_region.current.name, "title": "ALB RequestCount" } },
      { "type": "metric", "width": 12, "height": 6,
        "properties": { "metrics": [[ "AWS/ApplicationELB","TargetResponseTime","LoadBalancer", aws_lb.bff_alb.arn_suffix ]],
                        "region": data.aws_region.current.name, "title": "ALB TargetResponseTime" } }
    ]
  })
}

############################
# OUTPUT DNS del ALB
############################
output "alb_dns_name" {
  value = aws_lb.bff_alb.dns_name
}
